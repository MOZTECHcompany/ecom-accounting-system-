# Public canonical viewer origin. Never use the Cloud Run run.app URL in Discord.
PUBLIC_ORIGIN=https://ads.corely.cc
ENFORCE_PUBLIC_HOST=true
# Direct Cloud Run domain mapping starts in capability mode. A future HTTPS
# load balancer + IAP rollout can set this to iap without changing viewer URLs.
VIEWER_ACCESS_MODE=capability
# IAP_AUDIENCE=/projects/PROJECT_NUMBER/global/backendServices/BACKEND_SERVICE_ID
# IAP_ALLOWED_EMAILS=owner@example.com
# IAP_ALLOWED_DOMAINS=example.com

# Exact Cloud Run audience used when the GCE LUNA worker obtains an ID token.
INGEST_AUDIENCE=https://luna-ads-dashboard-REPLACE.asia-east1.run.app
# Comma-separated exact service account emails. User accounts are rejected.
INGEST_ALLOWED_CALLERS=luna-openclaw@PROJECT_ID.iam.gserviceaccount.com

DASHBOARD_BUCKET=REPLACE-private-luna-ads-dashboards
DASHBOARD_OBJECT_PREFIX=luna-ads-dashboards

# Store DATABASE_URL in Secret Manager in production. Do not commit its value.
DATABASE_URL=postgresql://dashboard_runtime:REPLACE@localhost:5432/ecom?host=/cloudsql/PROJECT:REGION:INSTANCE

DEFAULT_TTL_SECONDS=2592000
MAX_TTL_SECONDS=7776000
MAX_ARTIFACT_BYTES=5242880
PORT=8080
